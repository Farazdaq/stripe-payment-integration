@startuml
left to right direction

actor "Front Desk Staff" as FDS
actor "Housekeeping Staff" as HS
actor "Maintenance Staff" as MS
actor "Supervisor" as SUP
actor "Incident Manager" as IM

actor "Android Wrapper Device" as AND
actor "WebRTC Backbone" as WEBRTC
actor "STT / Translation Service" as AI

rectangle "PTT Real-Time Voice System (Hotel Operations)" {

  usecase "Join PTT Channel" as UC1
  usecase "Leave PTT Channel" as UC2

  usecase "Push-to-Talk (Start Transmission)" as UC3
  usecase "Release Transmission" as UC4

  usecase "Receive Live Audio" as UC5

  usecase "Floor Control (Single Speaker Rule)" as UC6

  usecase "Create / Join Live Call" as UC7
  usecase "Rejoin Call After Disconnect" as UC8

  usecase "Activate Incident Channel" as UC9
  usecase "Send Incident Message" as UC10

  usecase "Generate Transcript (STT)" as UC11
  usecase "Translate Message" as UC12
  usecase "Create Voice Card (Audio + Transcript)" as UC13

  usecase "Device Registration & Presence" as UC14
  usecase "Network Reconnect Handling" as UC15

  usecase "Send Push Notification" as UC16
  usecase "Audit Logging" as UC17
}

